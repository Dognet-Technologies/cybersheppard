[Unit]
Description=CyberSheppard eBPF Sensor (opt-in) — colma i blind-spot di auditd/Laurel
After=auditd.service
Wants=auditd.service

[Service]
Type=simple
# Richiede privilegi (root). Il chooser preferisce il binario CO-RE (produzione)
# e ripiega sul collector bpftrace (MVP) se il binario non è installato.
ExecStart=/opt/cybersheppard-ebpf/run-sensor.sh
Restart=on-failure
RestartSec=5s
# Il sensore scrive nello stream eventi che l'agent inoltra.
Environment=EBPF_SINK=/var/log/laurel/audit.log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cybersheppard-ebpf

[Install]
WantedBy=multi-user.target
