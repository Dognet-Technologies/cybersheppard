# ============================================================================
# CYBERSHEPPARD - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in real values
# DO NOT commit .env with real secrets to version control!

# ============================================================================
# Application Settings
# ============================================================================
NODE_ENV=production
RUST_LOG=info
DJANGO_SETTINGS_MODULE=hardening_engine.settings_production
DEBUG=false

# ============================================================================
# Security Keys (CHANGE THESE!)
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
CSRF_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
DJANGO_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
ENCRYPTION_KEY=CHANGE_ME_TO_32_BYTE_BASE64_KEY

# ============================================================================
# Database - PostgreSQL
# ============================================================================
DATABASE_URL=postgresql://cybersheppard:STRONG_PASSWORD_HERE@localhost:5432/cybersheppard
POSTGRES_USER=cybersheppard
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=cybersheppard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool settings
PG_POOL_MAX_SIZE=20
PG_POOL_MIN_SIZE=5
PG_POOL_TIMEOUT=30

# ============================================================================
# Database - InfluxDB
# ============================================================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=CHANGE_ME_TO_INFLUX_ADMIN_TOKEN
INFLUXDB_ORG=cybersheppard
INFLUXDB_BUCKET_METRICS=metrics
INFLUXDB_BUCKET_LOGS=logs
INFLUXDB_BUCKET_CORRELATIONS=correlations

# ============================================================================
# Server Ports
# ============================================================================
BACKEND_RUST_PORT=8080
BACKEND_RUST_HOST=127.0.0.1
BACKEND_DJANGO_PORT=8001
BACKEND_DJANGO_HOST=127.0.0.1

# ============================================================================
# CORS Settings
# ============================================================================
CORS_ALLOWED_ORIGINS=https://cybersheppard.local,https://www.cybersheppard.local
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_REQUESTS_PER_SECOND=10
RATE_LIMIT_BURST=20
AUTH_RATE_LIMIT_PER_MINUTE=5

# ============================================================================
# JWT Token Settings
# ============================================================================
JWT_ACCESS_TOKEN_EXPIRY=3600        # 1 hour
JWT_REFRESH_TOKEN_EXPIRY=604800     # 7 days
JWT_ISSUER=cybersheppard
JWT_AUDIENCE=cybersheppard-users

# ============================================================================
# Notification Settings - Email
# ============================================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@cybersheppard.local
SMTP_PASSWORD=CHANGE_ME_TO_SMTP_PASSWORD
SMTP_FROM_EMAIL=alerts@cybersheppard.local
SMTP_FROM_NAME=CyberSheppard Alerts
SMTP_USE_TLS=true

# ============================================================================
# Notification Settings - Slack
# ============================================================================
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#cybersheppard-alerts
SLACK_USERNAME=CyberSheppard
SLACK_ICON_EMOJI=:shield:

# ============================================================================
# Notification Settings - Discord
# ============================================================================
DISCORD_ENABLED=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL
DISCORD_USERNAME=CyberSheppard

# ============================================================================
# Integration Settings - Sentinel Core
# ============================================================================
SENTINEL_ENABLED=true
SENTINEL_API_URL=https://sentinel.local/api
SENTINEL_API_KEY=CHANGE_ME_TO_SENTINEL_API_KEY
SENTINEL_SYNC_INTERVAL_MINUTES=60

# ============================================================================
# Integration Settings - FireDog
# ============================================================================
FIREDOG_ENABLED=true
FIREDOG_API_URL=https://firedog.local/api
FIREDOG_API_KEY=CHANGE_ME_TO_FIREDOG_API_KEY
FIREDOG_SYNC_INTERVAL_MINUTES=30

# ============================================================================
# Monitoring Settings
# ============================================================================
MONITORING_INTERVAL_SECONDS=300     # Default monitoring interval for targets
MONITORING_RETENTION_DAYS=90        # How long to keep metrics in InfluxDB
COMPLIANCE_CHECK_ENABLED=true

# ============================================================================
# Hardening Settings
# ============================================================================
HARDENING_BACKUP_ENABLED=true
HARDENING_BACKUP_DIR=/var/backups/cybersheppard
HARDENING_DRY_RUN_DEFAULT=false
HARDENING_MODELS_PATH=/opt/cybersheppard/hardening-models

# ============================================================================
# SSL/TLS Settings
# ============================================================================
SSL_CERT_PATH=/etc/nginx/ssl/cybersheppard.crt
SSL_KEY_PATH=/etc/nginx/ssl/cybersheppard.key
SSL_DHPARAM_PATH=/etc/nginx/ssl/dhparam.pem

# ============================================================================
# Logging Settings
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/cybersheppard/app.log
LOG_MAX_SIZE=100M
LOG_MAX_BACKUPS=10
LOG_ROTATION_DAYS=30

# ============================================================================
# Backup Settings
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *           # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/var/backups/cybersheppard/db
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=cybersheppard-backups
BACKUP_S3_REGION=us-east-1

# ============================================================================
# Performance Settings
# ============================================================================
WORKER_THREADS=4
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT_SECONDS=30
WEBSOCKET_TIMEOUT_SECONDS=3600

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_WEBSOCKET_STREAMING=true
FEATURE_AUTO_REMEDIATION=false
FEATURE_VULNERABILITY_SYNC=true
FEATURE_THREAT_INTELLIGENCE=true
FEATURE_EMAIL_NOTIFICATIONS=true

# ============================================================================
# Compliance Settings
# ============================================================================
COMPLIANCE_AUTO_NOTIFY=true
COMPLIANCE_NOTIFY_SEVERITIES=critical,high
COMPLIANCE_SCORE_THRESHOLD=70       # Minimum acceptable compliance score

# ============================================================================
# Security Settings
# ============================================================================
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
CSRF_COOKIE_SECURE=true

# ============================================================================
# External Services (Optional)
# ============================================================================
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
SENTRY_DSN=                         # Optional: Sentry error tracking
