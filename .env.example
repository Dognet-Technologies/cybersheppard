# ============================================================================
# CYBERSHEPPARD (MicroSIEM) - Environment Configuration
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybersheppard
POSTGRES_USER=cybersheppard
POSTGRES_PASSWORD=change_me_in_production

# InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=change_me_in_production
INFLUXDB_ORG=cybersheppard
INFLUXDB_BUCKET_METRICS=metrics
INFLUXDB_BUCKET_LOGS=logs
INFLUXDB_BUCKET_CORRELATIONS=correlations

# ============================================================================
# RUST BACKEND CONFIGURATION
# ============================================================================

RUST_HOST=0.0.0.0
RUST_PORT=8080
RUST_LOG=info

# JWT Configuration
JWT_SECRET=change_me_to_random_64_char_string_in_production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# CSRF Configuration
CSRF_SECRET=change_me_to_random_64_char_string_in_production

# ============================================================================
# DJANGO BACKEND CONFIGURATION
# ============================================================================

DJANGO_SECRET_KEY=change_me_to_random_string_in_production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=8001

# Encryption key for SSH keys and passwords (Fernet)
ENCRYPTION_KEY=change_me_to_base64_encoded_32_byte_key

# ============================================================================
# INTEGRATIONS
# ============================================================================

# Sentinel Core
SENTINEL_CORE_ENABLED=false
SENTINEL_CORE_BASE_URL=http://sentinel-core:8080
SENTINEL_CORE_API_KEY=

# FireDog
FIREDOG_ENABLED=false
FIREDOG_BASE_URL=http://firedog:8000
FIREDOG_API_KEY=

# ============================================================================
# MONITORING
# ============================================================================

DEFAULT_MONITORING_INTERVAL_SECONDS=30
TARGET_OFFLINE_THRESHOLD_MINUTES=5

# ============================================================================
# NOTIFICATIONS
# ============================================================================

# Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=cybersheppard
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=cybersheppard@localhost
EMAIL_RECIPIENTS=admin@example.com

# Slack
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# ============================================================================
# SECURITY
# ============================================================================

# SSH Keys
SSH_KEY_DEFAULT_TYPE=ed25519
SSH_KEY_ROTATION_DAYS=90

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# ============================================================================
# HARDENING
# ============================================================================

HARDENING_MODELS_PATH=/app/hardening-models
HARDENING_BACKUP_PATH=/app/tmp/backups
HARDENING_APPLY_TIMEOUT_SECONDS=300

# ============================================================================
# FRONTEND
# ============================================================================

FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# ============================================================================
# DEVELOPMENT
# ============================================================================

NODE_ENV=development
