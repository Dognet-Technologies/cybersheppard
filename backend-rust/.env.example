# ============================================================================
# CYBERSHEPPARD (MicroSIEM) - Environment Configuration
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# Database - PostgreSQL
DATABASE_URL=postgresql://vlnman:DogNET@localhost:5432/cybersheppard
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Database - InfluxDB
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=cybersheppard
INFLUXDB_BUCKET=security_events
INFLUXDB_TOKEN=your-influxdb-token-here

# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=3600

# Session Secret (CHANGE IN PRODUCTION!)
SESSION_SECRET=change-this-session-secret-in-production

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Plugin System
PLUGINS_DIR=/var/cybersheppard/plugins
PLUGINS_ENABLE_UNSTABLE=false

# System User (for production VM)
SYSTEM_USER=microcyber

# Environment
ENVIRONMENT=development
