{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                correlation_type,\n                severity,\n                risk_score,\n                pattern_name,\n                pattern_description,\n                involved_hosts,\n                involved_users,\n                created_at\n            FROM event_correlations\n            WHERE created_at > $1\n              AND status = 'active'\n              AND (severity IN ('critical', 'high') OR risk_score > 60)\n            ORDER BY created_at DESC\n            ",
