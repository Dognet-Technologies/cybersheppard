  "query": "\n            SELECT\n                id,\n                correlation_id,\n                current_compromised_host,\n                current_compromised_user,\n                current_attack_stage,\n                predictions,\n                model_confidence,\n                created_at,\n                expires_at\n            FROM lateral_movement_predictions\n            WHERE status = 'active'\n              AND expires_at > NOW()\n            ORDER BY model_confidence DESC, created_at DESC\n            LIMIT $1\n            ",
