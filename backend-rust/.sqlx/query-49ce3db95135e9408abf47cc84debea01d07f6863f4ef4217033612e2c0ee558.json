  "query": "\n        SELECT id, target_id, metric_name, severity, detected_value, first_detected_at\n        FROM compliance_violations\n        WHERE first_detected_at > NOW() - INTERVAL '5 seconds'\n        AND status = 'new'\n        ORDER BY first_detected_at DESC\n        LIMIT 10\n        ",
