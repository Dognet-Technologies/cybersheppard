  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                e.event_type,\n                e.event_category,\n                e.severity,\n                e.anomaly_score\n            FROM security_events e\n            INNER JOIN event_correlations c ON e.correlation_id = c.id\n            WHERE c.id = $1\n            ORDER BY e.timestamp\n            ",
