  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                source_host,\n                user_name,\n                anomaly_score,\n                event_type,\n                timestamp\n            FROM security_events\n            WHERE timestamp > $1\n              AND anomaly_score > 70\n            ORDER BY anomaly_score DESC\n            LIMIT 50\n            ",
