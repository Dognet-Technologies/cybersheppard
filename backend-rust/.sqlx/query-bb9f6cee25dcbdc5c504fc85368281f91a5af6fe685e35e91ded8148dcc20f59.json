{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                host_name,\n                total_risk_score,\n                risk_level,\n                last_calculated\n            FROM host_risk_scores\n            WHERE last_calculated > $1\n              AND total_risk_score > 60\n            ORDER BY total_risk_score DESC\n            LIMIT 20\n            ",
